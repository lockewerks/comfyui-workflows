      "mode": 0,
      "inputs": [],
      "outputs": [],
      "title": "Sampling stack",
      "properties": {},
      "widgets_values": [
        "LTX does not use KSampler:\n  ModelSamplingLTXV  patches the sigma shift, fed the latent so it adapts to shape\n  LTXVScheduler      builds the sigma curve (stretch on, terminal 0.1)\n  KSamplerSelect     picks the algorithm\n  SamplerCustom      consumes model + sigmas + sampler\n\nLTXVConditioning stamps frame_rate into the conditioning. It must match the\nframe_rate on Save video or motion speed reads wrong with no error."
      ],
      "color": "#432",
      "bgcolor": "#653"
    }
